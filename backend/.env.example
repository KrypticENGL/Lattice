# Clerk secret key (Dashboard -> API Keys). Required: the backend uses it
# to fetch Clerk's JWKS and verify session tokens on protected routes
# (/api/execute, /api/resources, /api/canvases/*).
CLERK_SECRET_KEY=

# Postgres connection string, backing persistent canvases (backend/src/canvases).
# Lattice uses a hosted Supabase database — grab the connection string from
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
#
# Percent-encode the password before pasting it in. Supabase generates
# passwords containing URL delimiters (#, &, %, @, /), and left raw they
# split the URL at the wrong place — the failure surfaces as a confusing
# "failed to lookup address information: Name or service not known".
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Svix signing secret for the Clerk webhook endpoint (Clerk Dashboard ->
# Webhooks -> your endpoint -> Signing Secret). Optional: without it,
# POST /api/webhooks/clerk reports 503 and refuses to apply unverified
# events, and the `users`/`sessions` tables stay only as fresh as the
# import the backend runs at startup.
#
# Point the Clerk endpoint at <your-host>/api/webhooks/clerk and subscribe
# to: user.created, user.updated, user.deleted, session.created,
# session.ended, session.removed, session.revoked.
CLERK_WEBHOOK_SECRET=

# MongoDB, where the user's work is stored — canvases, Code-Canvas graphs
# and posts. Identity stays in Postgres above; nothing is kept in both.
#
# The SRV string from Atlas -> Connect -> Drivers. Note that it carries no
# database name, so the database is named separately below. Make sure the
# machine running this backend is on the cluster's Network Access list, or
# every query fails with a server-selection timeout.
MONGODB_URI=mongodb+srv://<user>:<url-encoded-password>@<cluster>.mongodb.net/?appName=<app>
# Optional; defaults to "lattice".
MONGODB_DATABASE=lattice
