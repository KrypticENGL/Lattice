{
  "name": "lattice",
  "version": "0.1.0",
  "private": true,
  "description": "Runtime-Trace Based Data-Structure Visualizer with Dynamic Input",
  "scripts": {
    "dev": "concurrently --names backend,frontend,ytmusic --prefix-colors cyan,green,magenta \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:ytmusic\"",
    "dev:backend": "cd backend && cargo run",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:ytmusic": "cd backend/ytmusic && .venv/bin/uvicorn service:app --port 8001 --reload",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "check": "cd backend && cargo check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KrypticENGL/Lattice.git"
  },
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
